{
  "name": "tiend3o",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @tiend3o/server dev\" \"pnpm --filter @tiend3o/web dev\"",
    "dev:web": "pnpm --filter @tiend3o/web dev",
    "dev:server": "pnpm --filter @tiend3o/server dev",
    "build": "pnpm --filter @tiend3o/shared build && pnpm --filter @tiend3o/core build && pnpm --filter @tiend3o/server build && pnpm --filter @tiend3o/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
